<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keys that Xcode's generated Info.plist cannot express on its own. Xcode merges this file
  with the generated one (GENERATE_INFOPLIST_FILE = YES + INFOPLIST_FILE = Config/Info.plist).
  It lives outside the synchronised ConciergeClock/ folder so it is not copied as a resource.
  Translations of the permission texts: ConciergeClock/<lang>.lproj/InfoPlist.strings.

  Microphone, Speech Recognition and Apple Health texts are added with the phases that use them.
-->
<plist version="1.0">
<dict>
	<!-- AlarmKit (Phase 1b): real alarms that ring through silent mode and Focus. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>ConciergeClock schedules your alarms so they ring even when the app is closed, in silent mode or during Focus.</string>
	<!-- Read on the iPhone: every calendar account in iOS Settings (iCloud, Google, Outlook, Exchange…). -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>ConciergeClock reads your calendars on this iPhone to tell you about your day and to skip alarms on days off. Nothing is uploaded or changed.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ConciergeClock listens for your answer when an alarm goes off ("dismiss", "remind me in 10 minutes"). Your voice stays on this iPhone and is never recorded.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your answer to an alarm is turned into text on this iPhone to understand it. Nothing is sent or stored.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>ConciergeClock reads your reminders on this iPhone to tell you what is due, and marks one done only when you ask. Nothing is uploaded.</string>
	<!-- The alarm's Lock Screen and Dynamic Island view (AlarmKit Live Activity). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Full backups (.conciergeclock, JSON): created here and opened from Files, AirDrop and Mail. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.greatergoodsoftware.conciergeclock.backup</string>
			<key>UTTypeDescription</key>
			<string>ConciergeClock Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>conciergeclock</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ConciergeClock Backup</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.greatergoodsoftware.conciergeclock.backup</string>
			</array>
		</dict>
	</array>
	<!-- Backups are read when opened, never edited in place. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- The only network use is the optional offline AI model download, which the person starts (https only). -->
	<key>NSAppTransportSecurity</key>
	<dict/>
</dict>
</plist>
